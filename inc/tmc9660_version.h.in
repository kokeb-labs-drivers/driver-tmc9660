/**
 * @file tmc9660_version.h
 * @brief TMC9660 driver version, generated by CMake from tmc9660_version.h.in.
 * @copyright Copyright (c) 2026 The driver-tmc9660 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/tmc9660_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef TMC9660_VERSION_H
#define TMC9660_VERSION_H

/** Major version: incompatible API changes. */
#define TMC9660_VERSION_MAJOR @TMC9660_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define TMC9660_VERSION_MINOR @TMC9660_VERSION_MINOR@
/** Patch version: fixes. */
#define TMC9660_VERSION_PATCH @TMC9660_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define TMC9660_VERSION_STRING "@TMC9660_VERSION@"

#endif // TMC9660_VERSION_H
